<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the FinAssist logo centred on white.
     The logo is 400 x 215 px, so 160 x 86 dp keeps its shape and matches
     the logo on Log In. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item
        android:width="160dp"
        android:height="86dp"
        android:drawable="@drawable/splash_logo_light"
        android:gravity="center" />
</layer-list>
