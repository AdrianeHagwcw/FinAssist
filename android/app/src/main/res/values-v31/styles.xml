<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch screen: the FinAssist logo on white, the app's
         default look. It stays up until the first real screen is ready. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Android 13+ only: MainActivity picks one of these for the next launch
         so the launch screen matches the theme chosen in the app. The dark
         background is the app's dark card colour. -->
    <style name="SplashLight" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="SplashDark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#1B222B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
    </style>
</resources>
