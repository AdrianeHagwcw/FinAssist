<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch screen follows the theme chosen in the app, not the
         phone's, so it stays white here too: a new install starts in light
         mode. Android 13+ switches it to dark for anyone who chose dark mode
         in the app (see MainActivity). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
