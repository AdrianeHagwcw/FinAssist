rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own data: their
    // profile document (users/{userId}) and everything stored under it, such
    // as expenses, income, category budgets, wallets, bills and goals.
    // No one can read or write another user's data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Prices the web scraper collects (inflation, building cost, gold,
    // zonal values, Pag-IBIG rates). Any signed-in user can read them;
    // only the scraper writes them, with its own key, which skips these
    // rules. Its run log (scraperRuns) has no rule, so the app can't
    // reach it at all.
    match /priceReferences/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
